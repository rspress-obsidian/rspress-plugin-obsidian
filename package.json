{
	"name": "rspress-plugin-obsidian",
	"version": "0.0.0-development",
	"description": "Publish an Obsidian vault with Rspress: wikilinks, backlinks, callouts, transclusion, Dataview, daily notes (markdown); canvas; graph view.",
	"type": "module",
	"license": "MIT",
	"author": "Jacob Valor <jacob-programmer@tuta.io> (https://github.com/Jacob-Valor)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rspress-obsidian/rspress-plugin-obsidian.git"
	},
	"homepage": "https://github.com/rspress-obsidian/rspress-plugin-obsidian#readme",
	"bugs": {
		"url": "https://github.com/rspress-obsidian/rspress-plugin-obsidian/issues"
	},
	"packageManager": "bun@1.4.4",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.14.0"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./markdown": {
			"import": {
				"types": "./dist/markdown/index.d.ts",
				"default": "./dist/markdown.js"
			},
			"require": {
				"types": "./dist/markdown/index.d.cts",
				"default": "./dist/markdown.cjs"
			}
		},
		"./canvas": {
			"import": {
				"types": "./dist/canvas/index.d.ts",
				"default": "./dist/canvas.js"
			},
			"require": {
				"types": "./dist/canvas/index.d.cts",
				"default": "./dist/canvas.cjs"
			}
		},
		"./graph": {
			"import": {
				"types": "./dist/graph/index.d.ts",
				"default": "./dist/graph.js"
			},
			"require": {
				"types": "./dist/graph/index.d.cts",
				"default": "./dist/graph.cjs"
			}
		},
		"./graph/runtime/GraphPanel": {
			"types": "./dist/graph/runtime/GraphPanel.d.ts",
			"import": "./dist/graph/runtime/GraphPanel.js",
			"default": "./dist/graph/runtime/GraphPanel.js"
		},
		"./graph/runtime/GraphSidebar": {
			"types": "./dist/graph/runtime/GraphSidebar.d.ts",
			"import": "./dist/graph/runtime/GraphSidebar.js",
			"default": "./dist/graph/runtime/GraphSidebar.js"
		},
		"./styles.css": "./dist/styles.css",
		"./markdown/styles.css": "./dist/markdown.css",
		"./markdown/katex.css": "./dist/markdown/katex.css",
		"./canvas/styles.css": "./dist/canvas.css",
		"./graph/styles.css": "./dist/graph/runtime/graph-panels.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun scripts/clean.ts && tsup --tsconfig tsconfig.build.json && bunx tsc -p tsconfig.build.json && bun scripts/add-cjs-types.ts",
		"dev": "tsup --watch --tsconfig tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"format:check": "biome format",
		"test": "bun test",
		"test:doc-examples": "bun scripts/check-doc-examples.ts",
		"test:publish": "bun scripts/test-publish.ts",
		"test:types": "publint",
		"test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage && bun scripts/check-coverage.ts 0.97",
		"test:e2e": "playwright test --config playwright.config.ts",
		"docs:dev": "rspress dev",
		"docs:build": "rspress build",
		"obsidian:sync": "bun scripts/obsidian-sync.ts",
		"bench:graph": "bun scripts/bench-graph-build.ts",
		"generate-icons": "bun scripts/generate-icons.ts",
		"generate-media-fixtures": "bun scripts/generate-media-fixtures.ts",
		"prepublishOnly": "bun run build && bun run test:publish && bun run test:types",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run"
	},
	"dependencies": {
		"@types/mdast": "^4.0.4",
		"chrono-node": "^2.10.3",
		"fast-glob": "^3.3.3",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"katex": "^0.19.0",
		"lz-string": "^1.5.0",
		"marked": "^18.1.1",
		"mdast-util-math": "^3.0.0",
		"micromark-extension-math": "^3.1.0",
		"perfect-freehand": "^1.2.2",
		"rehype-raw": "^7.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"roughjs": "^4.6.6",
		"rrule": "^2.8.1",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"yaml": "^2.9.1"
	},
	"peerDependencies": {
		"@excalidraw/excalidraw": "^0.18.1",
		"@rspress/core": "^2.0.21",
		"lucide-static": ">=0.300.0",
		"maplibre-gl": "^5.0.0 || ^6.0.0",
		"mathjax-full": "^3.2.2",
		"mermaid": "^11.17.2 || ^12.2.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"react-force-graph-2d": "^1.29.1"
	},
	"peerDependenciesMeta": {
		"@excalidraw/excalidraw": {
			"optional": true
		},
		"lucide-static": {
			"optional": true
		},
		"maplibre-gl": {
			"optional": true
		},
		"mathjax-full": {
			"optional": true
		},
		"mermaid": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"react-force-graph-2d": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@excalidraw/excalidraw": "^0.18.1",
		"@happy-dom/global-registrator": "^20.14.0",
		"@mdx-js/mdx": "^3.1.1",
		"@playwright/test": "^1.64.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "1.4.4",
		"@types/estree": "^1.0.9",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"fast-check": "^4.10.2",
		"lightningcss": "^1.33.0",
		"maplibre-gl": "^6.15.0",
		"mathjax-full": "^3.2.2",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-mdx-jsx": "^3.2.0",
		"mdast-util-to-markdown": "^2.2.0",
		"mermaid": "^11.17.2",
		"publint": "^0.3.25",
		"react-force-graph-2d": "^1.29.2",
		"react-router-dom": "^7.18.4",
		"remark-stringify": "^11.0.0",
		"semantic-release": "^25.0.9",
		"serve": "^14.2.6",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vfile": "^6.0.3"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"release": {
		"branches": ["main"],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			["@semantic-release/changelog", {
				"changelogFile": "CHANGELOG.md",
				"changelogTitle": "# Changelog"
			}],
			["@semantic-release/npm", {
				"npmPublish": true,
				"pkgRoot": "release/package"
			}],
			"@semantic-release/github",
			[
				"@semantic-release/git",
				{
					"assets": ["CHANGELOG.md"],
					"message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
				}
			]
		]
	}
}
